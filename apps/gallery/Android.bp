// Product module is the Gradle-built APK (Omadroid Compose / Jetpack Foundation).
// Assemble with apps/gallery/gradlew assembleDebug, then copy
// build/outputs/apk/debug/*.apk to prebuilt/OmadroidGallery.apk.
//
// https://source.android.com/docs/setup/build/building

android_app_import {
    name: "OmadroidGallery",
    apk: "prebuilt/OmadroidGallery.apk",
    certificate: "platform",
    system_ext_specific: true,
    presigned: false,
    overrides: [
        "Gallery2",
    ],
    dex_preopt: {
        enabled: false,
    },
}
