// Product module is the Gradle-built APK (Omadroid Compose / Jetpack Foundation).
// Run scripts/build-clock.sh before lunch/m so prebuilt/OmadroidClock.apk exists.
//
// https://source.android.com/docs/setup/build/building

android_app_import {
    name: "OmadroidClock",
    apk: "prebuilt/OmadroidClock.apk",
    certificate: "platform",
    privileged: false,
    system_ext_specific: true,
    presigned: false,
    overrides: [
        "DeskClock",
    ],
    dex_preopt: {
        enabled: false,
    },
}
