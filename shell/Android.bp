// Host process. HOME. Plugins declare kinds; this module loads them.
//
// https://source.android.com/docs/setup/build/building

android_library {
    name: "OmadroidTheme",
    srcs: ["lib/theme/**/*.kt"],
    manifest: "lib/theme/AndroidManifest.xml",
    sdk_version: "current",
}

android_app {
    name: "OmadroidShell",
    srcs: ["src/main/java/**/*.kt"],
    static_libs: ["OmadroidTheme"],
    resource_dirs: ["src/main/res"],
    asset_dirs: ["plugins", "themes"],
    manifest: "src/main/AndroidManifest.xml",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
}
